 "info": {
  "title": "strata-voice",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/health": {
   "get": {
    "operationId": "get_health_api_health_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Get Health Api Health Get",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Get Health"
   }
  },
  "/api/manifest.jsonl": {
   "get": {
    "operationId": "get_manifest_api_manifest_jsonl_get",
    "responses": {
     "200": {
      "content": {
       "text/plain": {
        "schema": {
         "type": "string"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Get Manifest"
   }
  },
  "/api/prompts": {
   "get": {
    "operationId": "get_prompts_api_prompts_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/PromptOut"
         },
         "title": "Response Get Prompts Api Prompts Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Get Prompts"
   }
  },

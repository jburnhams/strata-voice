  "/api/prompts/{prompt_id}/takes": {
   "post": {
    "operationId": "post_take_api_prompts__prompt_id__takes_post",
    "parameters": [
     {
      "in": "path",
      "name": "prompt_id",
      "required": true,
      "schema": {
       "title": "Prompt Id",
       "type": "integer"
      }
     },
     {
      "in": "query",
      "name": "device",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],

 "paths": {
  "/api/coverage": {
   "get": {
    "operationId": "get_coverage_api_coverage_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Coverage"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Get Coverage"
   }
  },
  "/api/health": {
   "get": {
    "operationId": "get_health_api_health_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Get Health Api Health Get",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Get Health"
   }
  },
  "/api/manifest.jsonl": {
   "get": {
    "operationId": "get_manifest_api_manifest_jsonl_get",

   "delete": {
    "operationId": "delete_skip_api_prompts__prompt_id__skip_delete",
    "parameters": [
     {
      "in": "path",
      "name": "prompt_id",
      "required": true,
      "schema": {
       "title": "Prompt Id",
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PromptOut"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Delete Skip"
   },
   "post": {
    "operationId": "post_skip_api_prompts__prompt_id__skip_post",
    "parameters": [
     {
      "in": "path",
      "name": "prompt_id",
      "required": true,
      "schema": {
       "title": "Prompt Id",
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PromptOut"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Post Skip"
   }
  },
  "/api/prompts/{prompt_id}/takes": {
   "post": {
    "operationId": "post_take_api_prompts__prompt_id__takes_post",
    "parameters": [
     {
      "in": "path",
      "name": "prompt_id",
      "required": true,
      "schema": {
       "title": "Prompt Id",
       "type": "integer"
      }
     },
     {
      "in": "query",
      "name": "device",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Device"
      }
     }
    ],
    "requestBody": {
     "content": {
      "audio/wav": {
       "schema": {
        "format": "binary",
        "type": "string"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/TakeOut"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Post Take"
   }
  },
